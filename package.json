{
  "name": "framer-token-importer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode https",
    "dev:http": "vite",
    "doc:dev": "npm run docs:dev",
    "docs:dev": "node scripts/serve-docs.mjs",
    "catalog:dev": "ladle serve --host 127.0.0.1 --port 61000",
    "catalog:build": "ladle build",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/jost": "^5.2.8",
    "framer-plugin": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-framer": "^1.1.1",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.2.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
